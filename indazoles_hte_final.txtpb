      }
    }
  }
  inputs {
    key: "Catalyst Stock Solution"
    value {
      components {
        identifiers {
          type: SMILES
          value: "CC(C)C1=CC(C(C)C)=C(C2=C(P(C(C)(C)C)(C(C)(C)C)->[Pd]3(OS(C)(=O)=O)<-NC4=C(C=CC=C4)C4=CC=CC=C43)C=CC=C2)C(C(C)C)=C1"
        }
        identifiers {
          type: NAME
          value: "tBuXPhos Pd G3"
        }
        amount {
          moles {
            value: 1.0
            units: MICROMOLE
          }
        }
        reaction_role: CATALYST
      }
      components {
        identifiers {
          type: SMILES
          value: "C1COCCO1"
        }
        identifiers {
          type: NAME
          value: "1,4-Dioxane"
        }
        amount {
          volume {
            value: 50.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_order: 4
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
  }
  inputs {
    key: "Coupling Partner Stock Solution"
    value {
      components {
        identifiers {
          type: SMILES
          value: "Nc1c2cnccc2ccc1"
        }
        amount {
          moles {
            value: 20.0
            units: MICROMOLE
          }
        }
        reaction_role: REACTANT
        is_limiting: false
      }
      components {
        identifiers {
          type: SMILES
          value: "C1COCCO1"
        }
        identifiers {
