          value: "TFA"
        }
        amount {
          volume {
            value: 200.0
            units: MICROLITER
          }
        }
        reaction_role: WORKUP
      }
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
    stirring {
      type: STIR_BAR
    }
  }
  workups {
    type: STIRRING
    duration {
      value: 2.0
      units: HOUR
    }
    stirring {
      type: STIR_BAR
    }
  }
