        }
        identifiers {
          type: NAME
          value: "XPhos Pd G3"
        }
        amount {
          moles {
            value: 1.0
            units: MICROMOLE
          }
        }
        reaction_role: CATALYST
      }
      components {
        identifiers {
          type: SMILES
          value: "CC1CCCO1"
        }
        identifiers {
          type: NAME
          value: "2-Methyltetrahydrofuran"
        }
        amount {
          volume {
            value: 50.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_order: 4
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
  }
  inputs {
