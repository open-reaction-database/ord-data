    amount {
      volume {
        value: 50.0
        units: MICROLITER
      }
    }
    is_automated: false
  }
  workups {
    type: FILTRATION
    details: "50uL of each well were sampled and dispensed onto a filter plate and eluted with a total of 2mL of DCM:MeOH:DMEA (17:2:1) into a deep well plate"
    keep_phase: "liquid"
  }
