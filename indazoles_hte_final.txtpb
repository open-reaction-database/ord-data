        uses_internal_standard: false
        is_normalized: false
        uses_authentic_standard: false
        float_value {
          value: 34765.0
        }
        mass_spec_details {
          type: TIC_POSITIVE
        }
      }
      measurements {
        analysis_key: "LCMS"
        type: AREA
        details: "LC-MS peak area of product normalized against internal standard (1,3,5-trimethoxybenzene); no authentic/calibration standard used, so values are relative, not absolute yield"
        uses_internal_standard: true
        is_normalized: true
        uses_authentic_standard: false
        float_value {
          value: 0.115
        }
        mass_spec_details {
          type: TIC_POSITIVE
        }
      }
