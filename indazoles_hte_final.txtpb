        type: SMILES
        value: "COC(C=CN=C1NC(C=C2)=CC3=C2C(N)=NN3)=C1C#N"
      }
      is_desired_product: true
      measurements {
        analysis_key: "LCMS"
        type: IDENTITY
        details: "product confirmation by LCMS in positive mode"
