        mass_spec_details {
          type: TIC_POSITIVE
        }
      }
      reaction_role: INTERNAL_STANDARD
    }
    analyses {
      key: "LCMS"
      value {
        type: LCMS
        details: "LCMS analysis of the individual reaction after workup, but before pooling of reactions and purification by flash chromatography."
        is_of_isolated_species: false
      }
    }
    analyses {
      key: "NMR"
      value {
        type: NMR_1H
        details: "NMR analysis after pooling all 24 reactions with the same product and purification by flash chromatography."
        is_of_isolated_species: true
        data {
          key: "13C NMR"
          value {
            string_value: "delta (ppm) = 171.1 (C-4-pyridine), 158.8 (C-2-pyridine), 154.1 (C-6-pyridine), 150.4 (C-6-indazole), 146.1 (C-7a-indazole), 145.0 (C-3-indazole), 122.8 (C-4-indazole), 117.5 (C-5-indazole), 114.4 (C$\\equiv$N), 108.8 (C-3a-indazole), 101.4 (C-5-pyridine), 101.0 (C-7-indazole), 85.2 (C-3-pyridine), 57.5 (CH3)."
            description: "13C NMR (151 MHz, CD3OD) -- SI compound 43 (2-[(3-Amino-1H-indazol-6-yl)amino]-4-methoxynicotinonitrile)"
          }
        }
        data {
          key: "1H NMR"
          value {
            string_value: "delta (ppm) = 8.29 (d, J = 6.0 Hz, 1H, 6-CH-pyridine), 7.90 (d, J = 1.8 Hz, 1H, 7-CH-indazole), 7.79 (d, J = 8.8 Hz, 1H, 4-CH-indazole), 7.26 (dd, J = 8.9, 1.8 Hz, 1H, 5-CH-indazole), 6.76 (d, J = 6.0 Hz, 1H, 5-CH-pyridine), 4.03 (s, 3H, CH3)."
            description: "1H NMR (600 MHz, CD3OD) -- SI compound 43 (2-[(3-Amino-1H-indazol-6-yl)amino]-4-methoxynicotinonitrile)"
          }
        }
        data {
          key: "NMR Result"
          value {
            string_value: "NMR spectra of the pooled reactions confirmed that expected product was present."
          }
        }
      }
    }
  }
