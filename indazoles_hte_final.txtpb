            description: "1H NMR (600 MHz, CD3OD) -- SI compound 23 (6-(Pyridin-4-yl)-1H-indazol-3-amine)"
          }
        }
        data {
          key: "NMR Result"
          value {
            string_value: "NMR spectra of the pooled reactions confirmed that expected product was present."
          }
        }
      }
