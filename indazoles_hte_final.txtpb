            units: MICROLITER
          }
        }
        reaction_role: WORKUP
      }
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
    stirring {
      type: STIR_BAR
    }
  }
  workups {
