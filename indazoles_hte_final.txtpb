          value: "CO"
        }
        identifiers {
          type: NAME
          value: "Methanol"
        }
        amount {
          volume {
            value: 50.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
