          value {
            string_value: "delta (ppm) = 7.99 (d, J = 8.6 Hz, 1H, 4-CH-indazole), 7.84 - 7.81 (m, 1H, 2-CH-phenyl), 7.80 - 7.74 (m, 1H, 6-CH-phenyl), 7.67 - 7.63 (m, 1H, 7-CH-indazole), 7.58 (t, J = 7.7 Hz, 1H, 5-CH-phenyl), 7.55 - 7.49 (m, 2H, 4-CH-phenyl, 5-CH-indazole), 4.23 (s, 2H, CH2 -phenyl)."
            description: "1H NMR (600 MHz, CD3OD) -- SI compound 13 (6-[3-(Aminomethyl)-phenyl]-1H-indazol-3-amine)"
          }
        }
        data {
          key: "NMR Result"
          value {
            string_value: "NMR spectra of the pooled reactions confirmed that expected product was present."
          }
        }
      }
    }
