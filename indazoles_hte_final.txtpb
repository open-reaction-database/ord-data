      }
    }
  }
  inputs {
    key: "Catalyst Stock Solution"
    value {
      components {
        identifiers {
          type: SMILES
          value: "COC1=CC=CC(OC)=C1C1=C(P(C2CCCCC2)(C2CCCCC2)->[Pd]2(OS(C)(=O)=O)<-NC3=C(C=CC=C3)C3=CC=CC=C32)C=CC=C1"
        }
        identifiers {
          type: NAME
          value: "SPhos Pd G3"
        }
        amount {
          moles {
            value: 1.0
            units: MICROMOLE
          }
        }
        reaction_role: CATALYST
      }
      components {
        identifiers {
          type: SMILES
          value: "C1COCCO1"
        }
        identifiers {
          type: NAME
          value: "1,4-Dioxane"
        }
        amount {
          volume {
            value: 50.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_order: 4
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
  }
  inputs {
    key: "Coupling Partner Stock Solution"
    value {
      components {
        identifiers {
          type: SMILES
          value: "COc1c(C#N)c(N)ncc1"
        }
        amount {
          moles {
            value: 20.0
            units: MICROMOLE
          }
        }
        reaction_role: REACTANT
        is_limiting: false
      }
      components {
        identifiers {
          type: SMILES
          value: "C1COCCO1"
        }
        identifiers {
          type: NAME
          value: "1,4-Dioxane"
        }
        amount {
          volume {
            value: 50.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_order: 2
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
  }
  inputs {
    key: "Indazole Stock solution"
    value {
      components {
        identifiers {
          type: SMILES
          value: "BrC(C=C1)=CC2=C1C(N(C(OC(C)(C)C)=O)C(OC(C)(C)C)=O)=NN2C(OC(C)(C)C)=O"
        }
        amount {
          moles {
            value: 10.0
            units: MICROMOLE
          }
        }
        reaction_role: REACTANT
        is_limiting: true
      }
      components {
        identifiers {
          type: SMILES
          value: "C1COCCO1"
        }
        identifiers {
          type: NAME
          value: "1,4-Dioxane"
        }
        amount {
          volume {
            value: 100.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_order: 1
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
  }
  setup {
    vessel {
      type: WELL_PLATE
      details: "96-well Para-dox Aluminium Reaction Block"
      material {
        type: GLASS
        details: "800uL, 8x30mm Crimp Top Vial, Flat Bottom"
      }
      volume {
        value: 800.0
        units: MICROLITER
      }
    }
    is_automated: false
    environment {
      type: CUSTOM
      details: "Nitrogen Purged in Desiccator"
    }
  }
  conditions {
    temperature {
      control {
        type: DRY_ALUMINUM_PLATE
      }
      setpoint {
        value: 90.0
        units: CELSIUS
      }
    }
    pressure {
      control {
        type: SEALED
        details: "Standard 96-Position Parallel Synthesis Reaction Block"
      }
      atmosphere {
        type: NITROGEN
        details: "Sealed under nitrogen flow"
      }
    }
    stirring {
      type: STIR_BAR
      details: "Magnetic Stir Bars, PTFE Coated, 5mm x 2mm"
      rate {
        type: HIGH
      }
    }
    conditions_are_dynamic: false
  }
  notes {
    procedure_details: "Stock solutions of starting material tert-butyl 3-[bis(tert-butoxycarbonyl)amino]-6-bromo-1H-indazol-1-carboxylate (100 mM), amine coupling partners (400 mM), and catalysts (20 mM) were prepared in 1,4-Dioxane and 2-MeTHF. Solid Cs2CO3 (6.52 mg) and KOtBu (2.24 mg) were dispensed into their respective vials. A volume of 100 uL of the starting material stock solution and 50 uL of the amine and catalyst stock solutions were dosed into the reaction vials. The reaction block was transferred to a vacuum desiccator, evacuated, and backfilled with nitrogen three times. The plate was sealed under nitrogen flow according to the vendor\'s manual and stirred at 90 degC for 16 h. At the end of the reaction time, the plate was removed from the heat and allowed to cool. The reaction solvents were evaporated under a nitrogen atmosphere. A volume of 200 uL of TFA was added to each vial, the plate was sealed again, and the mixture was stirred at ambient temperature for 2 h. Afterward, 50 uL of a 1,3,5-trimethoxybenzene solution (50 mM in MeOH) was added as an internal standard. The solvents were again evaporated under nitrogen flow, and the residues were resuspended in 700 uL of eluent (DCM:MeOH:DMEA 17:2:1). A volume of 50 uL from each well was sampled and dispensed onto a filter plate, then eluted with a total of 2 mL of the aforementioned eluent. The filtrates were evaporated under a nitrogen atmosphere, diluted with 2 mL of MeOH, and 200 uL were taken for LC-MS measurements. The remaining reaction mixtures were pooled and purified via flash chromatography."
  }
  workups {
    type: CONCENTRATION
    details: "Evaporation of solvent under nitrogen flow from a custom 96-port blowdown apparatus"
    duration {
      value: 2.0
      units: HOUR
    }
    stirring {
      type: NONE
    }
  }
  workups {
    type: ADDITION
    input {
      components {
        identifiers {
          type: SMILES
          value: "O=C(O)C(F)(F)F"
        }
        identifiers {
          type: NAME
          value: "TFA"
        }
        amount {
          volume {
            value: 200.0
            units: MICROLITER
          }
        }
        reaction_role: WORKUP
      }
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
    stirring {
      type: STIR_BAR
    }
  }
  workups {
    type: STIRRING
    duration {
      value: 2.0
      units: HOUR
    }
    stirring {
      type: STIR_BAR
    }
  }
  workups {
    type: ADDITION
    details: "50uL of a 1,3,5-trimethoxybenzene solution (50mM in MeOH) was added as internal standard"
    input {
      components {
        identifiers {
          type: SMILES
          value: "COc1cc(OC)cc(OC)c1"
        }
        identifiers {
          type: NAME
          value: "1,3,5-Trimethoxybenzene"
        }
        amount {
          moles {
            value: 2.5
            units: MICROMOLE
          }
        }
        reaction_role: INTERNAL_STANDARD
      }
      components {
        identifiers {
          type: SMILES
          value: "CO"
        }
        identifiers {
          type: NAME
          value: "Methanol"
        }
        amount {
          volume {
            value: 50.0
            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
    stirring {
      type: STIR_BAR
      rate {
        type: HIGH
      }
    }
  }
  workups {
    type: CONCENTRATION
    details: "Evaporation of solvent under nitrogen flow from a custom 96-port blowdown apparatus"
    duration {
