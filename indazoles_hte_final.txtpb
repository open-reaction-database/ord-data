            units: MICROLITER
          }
          volume_includes_solutes: true
        }
        reaction_role: SOLVENT
      }
      addition_order: 1
      addition_speed {
        type: ALL_AT_ONCE
      }
      addition_device {
        type: PIPETTE
      }
    }
  }
  setup {
    vessel {
      type: WELL_PLATE
      details: "96-well Para-dox Aluminium Reaction Block"
      material {
        type: GLASS
        details: "800uL, 8x30mm Crimp Top Vial, Flat Bottom"
      }
      volume {
        value: 800.0
        units: MICROLITER
      }
